# DealFlow360 Environment Variables
# Copy this file to .env and fill in the values

# MongoDB
MONGO_URI=mongodb://localhost:27017/odoo

# Server
PORT=5000

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Frontend (CORS origin)
FRONTEND_URL=http://localhost:5173

# Razorpay (Phase 12 — fill in from Razorpay Dashboard)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
